# ==============================================================================
# Smart Attendance System - Production Environment Reference (.env.prod.example)
# ==============================================================================

# Application & Core Server Settings
PROJECT_NAME="Smart Attendance System API"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
LOG_LEVEL="INFO"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://postgres:YOUR_PRODUCTION_DB_PASSWORD@localhost:5432/smart_attendance?schema=public"

# Security & JWT Authentication
JWT_SECRET="CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET_KEY_FOR_PRODUCTION"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INVITATION_TOKEN_EXPIRE_HOURS=48
RESET_TOKEN_EXPIRE_MINUTES=15

# Redis Cache & Sessions
REDIS_URL="redis://localhost:6379/0"

# Object Storage (AWS S3 / Cloudflare R2 / MinIO)
AWS_ENDPOINT_URL=""
AWS_DEFAULT_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_OR_STORAGE_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_OR_STORAGE_SECRET_KEY"
S3_BUCKET_NAME="smart-attendance-production"

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@yourdomain.com"
SMTP_PASSWORD="YOUR_APP_SPECIFIC_PASSWORD"
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL="noreply@yourdomain.com"
EMAILS_FROM_NAME="Smart Attendance System"

# Frontend URL (CORS)
FRONTEND_URL="https://attendance.yourdomain.com"

# AI / Machine Learning Engine Settings
HF_TOKEN=""
TF_CPP_MIN_LOG_LEVEL="3"
TF_ENABLE_ONEDNN_OPTS="0"
CUDA_VISIBLE_DEVICES="-1"
TF_USE_LEGACY_KERAS="1"

# Database Seeder
SEED_TYPE="default"

# Sentry Monitoring
SENTRY_DSN=https://9e62f4cdab9492bcc05c312bddeb6918@o4512113532010496.ingest.us.sentry.io/4512113546297344
